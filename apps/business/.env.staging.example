# Staging overlay. Vite only loads .env.staging when the build is run
# in "staging" mode — plain `vite build` defaults to "production" mode
# and will NOT pick this file up. Use the build:staging script added
# in package.json (`vite build --mode staging`), which a staging
# Netlify site (or any staging build pipeline) should use as its
# build command instead of the default `npm run build`.
#
# Copy to .env.staging (or .env.staging.local) and point at the real
# staging backend. Never commit the filled-in file — already covered
# by the root .gitignore (.env.staging) and this app's own .gitignore
# (*.local).

VITE_API_URL=https://staging-api.wazzar.tz
