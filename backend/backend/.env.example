# This file is the local-dev baseline. For a real staging or production
# host, copy .env.staging.example -> .env.staging or
# .env.production.example -> .env.production instead — whichever matches
# NODE_ENV is loaded first, with this file (.env) as a fallback for
# anything not repeated there. See src/env-file.ts.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wazzar_db

# Set to "true" for managed Postgres providers that require SSL — Supabase,
# Render, most others (added 2026-08-22). Leave unset/false for local or
# Docker Postgres, which has no SSL at all.
DATABASE_SSL=

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins for both the HTTP API
# (CORS) and the /tracking WebSocket gateway — e.g.
# https://app.wazzar.tz,https://admin.wazzar.tz
# Leave unset for local dev (any origin is allowed, e.g. localhost on
# any port). MUST be set to your real frontend domain(s) in production —
# the server refuses to start in production (NODE_ENV=production)
# without it. See src/security-checks.ts.
CORS_ORIGIN=

# File uploads (rider onboarding docs, proof-of-delivery photos) —
# local-disk storage for now, served back out at /uploads/<filename>.
# See modules/uploads/ and MASTER_GAPS_AND_ROADMAP.md for the S3 swap
# plan. UPLOADS_DIR defaults to ./uploads if unset; PUBLIC_BASE_URL
# defaults to same-origin (fine for local dev) — set it to your real
# domain in production so returned URLs are absolute.
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=

# Swagger/OpenAPI docs, served at GET /docs (and the raw spec at
# GET /docs-json) — see src/swagger.ts. Defaults to ON everywhere except
# NODE_ENV=production, where it defaults to OFF (matches this repo's
# secure-by-default-in-production pattern — see security-checks.ts).
# Set explicitly to override either direction:
#   SWAGGER_ENABLED=true   forces docs on, including in production
#   SWAGGER_ENABLED=false  forces docs off, including outside production
SWAGGER_ENABLED=

# JWT — use two DIFFERENT random strings, not the same value twice
# (that's what stops a refresh token from being replayed as an access
# token). Generate with: openssl rand -hex 64
JWT_SECRET=<64-char random string>
JWT_EXPIRY_SECONDS=900
JWT_REFRESH_SECRET=<different 64-char random string>
JWT_REFRESH_EXPIRY_SECONDS=604800

# Payments — webhook signature verification is SKIPPED when a secret is
# unset (see modules/payments/webhook-signature.ts), which is fine for
# local/sandbox work but must never be left unset in production.
#
# Both providers stay on their mock/fake-data path (no network calls,
# random fake transaction IDs) until the real credentials below are
# filled in — nothing else needs to change. See
# docs/delivery-notes/PAYMENTS_GOING_LIVE.md for exactly what each
# value is, where to get it, and what still needs a human even with
# real credentials configured (M-Pesa refunds — see that doc).
MPESA_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# Stripe — real key always starts with sk_test_ (sandbox) or sk_live_
# (production). Leave unset to stay on the mock provider.
STRIPE_SECRET_KEY=

# M-Pesa (Safaricom Daraja) — all five must be set together to leave
# the mock provider (see hasRealMpesaCredentials() in mpesa.provider.ts)
# — a partial set intentionally still uses the mock, not a broken real
# call. MPESA_ENV is "sandbox" (default) or "production".
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox
