# Production overlay — copy to .env.production on the production host and
# fill in real values. Loaded FIRST when NODE_ENV=production (see
# src/env-file.ts), with .env as a fallback for anything not repeated
# here.
#
# NODE_ENV=production is the one setting src/security-checks.ts actually
# checks for — the app REFUSES TO START in production if CORS_ORIGIN,
# MPESA_WEBHOOK_SECRET, STRIPE_WEBHOOK_SECRET, JWT_SECRET, or
# JWT_REFRESH_SECRET are missing (or the two JWT secrets are identical).
# Every value below marked "required" is enforced at boot, not just
# recommended.

NODE_ENV=production

# Required. Real production database — never the same instance as staging.
DATABASE_URL=postgresql://<user>:<password>@<production-db-host>:5432/wazzar_prod
DATABASE_SSL=true

# Required (enforced by security-checks.ts). Comma-separated real
# frontend domains, e.g.:
#   https://app.wazzar.tz,https://admin.wazzar.tz,https://business.wazzar.tz
CORS_ORIGIN=

# Required so returned upload URLs (rider docs, proof-of-delivery photos)
# are absolute, not same-origin.
PUBLIC_BASE_URL=

# Off by default in production (see .env.example) — the API map is not
# meant to be public. Only flip to true if there's a specific reason to
# expose /docs in production.
SWAGGER_ENABLED=false

# Required (enforced by security-checks.ts) — generate with:
#   openssl rand -hex 64
# Must be two DIFFERENT random strings.
JWT_SECRET=<64-char random string>
JWT_REFRESH_SECRET=<different 64-char random string>

# Required (enforced by security-checks.ts). Real webhook signing secrets
# from each provider's dashboard — see PAYMENTS_GOING_LIVE.md for exactly
# where to find each one.
MPESA_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# Real credentials, not sandbox. Leaving these unset keeps production on
# the mock payment provider even with NODE_ENV=production — see
# PAYMENTS_GOING_LIVE.md before going live with real money.
STRIPE_SECRET_KEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=production
