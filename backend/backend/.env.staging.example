# Staging overlay — copy to .env.staging on the staging host and fill in
# real values. Loaded FIRST when NODE_ENV=staging (see src/env-file.ts),
# with .env as a fallback for anything not repeated here. It intentionally
# only lists the handful of values that actually differ between local dev
# and staging — everything else (JWT secrets, upload dir, etc.) still
# comes from .env unless you override it here too.
#
# NOTE: NODE_ENV=staging is NOT "production" as far as
# src/security-checks.ts is concerned — that check only runs when
# NODE_ENV=production, so a staging deploy is not currently forced to set
# CORS_ORIGIN/JWT secrets/webhook secrets the way a real production deploy
# is. Set them anyway (staging should mirror production config), the
# check just won't refuse to boot if you forget one here.

NODE_ENV=staging

# Point at the real staging database, not local Postgres.
DATABASE_URL=postgresql://<user>:<password>@<staging-db-host>:5432/wazzar_staging
DATABASE_SSL=true

# Staging frontend origin(s) — e.g. https://staging.app.wazzar.tz
CORS_ORIGIN=

# Staging should generally point at the real domain it's reachable on, not
# same-origin/localhost, so returned upload URLs resolve.
PUBLIC_BASE_URL=

# Leave Swagger on by default in staging (see .env.example) unless there's
# a specific reason to hide the API map here too.
SWAGGER_ENABLED=true

# M-Pesa/Stripe: staging should use each provider's own sandbox
# credentials (MPESA_ENV=sandbox, Stripe sk_test_...), never the same
# secrets as production. Leave both unset to keep staging on the mock
# payment provider — see PAYMENTS_GOING_LIVE.md.
